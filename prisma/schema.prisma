generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  // Kosongkan bagian ini, karena sudah dihandle oleh prisma.config.ts
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}